{
  "themeId": "noviolence",
  "version": "1.0.1",
  "worksheetRatio": "A4_VERTICAL",
  "description": "Only crop the top illustration area for exhibition. Do not include the title, prompt text, page number, speech bubble text, or writing box in the exhibition cutout.",
  "characterCropArea": {
    "x": 0.04,
    "y": 0.02,
    "width": 0.92,
    "height": 0.48
