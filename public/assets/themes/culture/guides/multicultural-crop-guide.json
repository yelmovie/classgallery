{
  "themeId": "multicultural",
  "version": "1.0.0",
  "worksheetRatio": "A4_VERTICAL",
  "description": "Only crop the top character illustration area for exhibition. Do not include the title, prompt text, or writing box in the exhibition cutout. The character must be the main focus, with minimal surrounding background.",
  "characterCropArea": {
    "x": 0.04,
    "y": 0.02,
    "width": 0.92,
    "height": 0.48
  },
  "titleArea": {
    "x": 0.04,
    "y": 0.5,
    "width": 0.92,
    "height": 0.13
  },
  "writingBoxArea": {
    "x": 0.06,
    "y": 0.66,
    "width": 0.88,
    "height": 0.3
  },
  "extractionRules": {
    "preserveCharacterColor": true,
    "preserveOriginalRgb": true,
    "makeCharacterOpaque": true,
    "removeOnlyOuterPaperBackground": true,
    "doNotRemoveInnerWhiteAreas": true,
    "doNotReduceOpacity": true,
    "addWhiteOuterBorder": true,
    "addSoftShadow": true,
    "excludeTitleFromExhibition": true,
    "excludeWritingBoxFromExhibition": true,
    "excludeLetterPromptFromExhibition": true,
    "preferLargeCharacterCutout": true,
    "avoidBackgroundDominance": true
  },
  "displayRules": {
    "displayMode": "character_cutout_only",
    "doNotDisplayFullWorksheetCard": true,
    "doNotDisplayTitle": true,
    "doNotDisplayWritingBox": true,
    "doNotDisplayLetterSection": true,
    "maxArtworks": 30,
    "recommendedArtworks": 24,
    "defaultSpeed": "slow",
    "spotlightEnabled": true
  },
  "worksheetLayout": {
    "topCharacterArea": {
      "fromY": 0.02,
      "toY": 0.5
    },
    "titleArea": {
      "fromY": 0.5,
      "toY": 0.63
    },
    "writingArea": {
      "fromY": 0.66,
      "toY": 0.96
    },
    "letterTitle": "서로 달라도 함께 빛나요",
    "letterPrompt": "나와 다른 문화를 존중하기 위해 내가 할 수 있는 일을 생각하고, 이유와 다짐이 드러나게 써 봅시다.",
    "writingLines": true,
    "studentNameField": false,
    "printNote": "이 활동지는 A4 세로 출력용입니다."
  },
  "notes": [
    "전시 화면에는 학습지 상단 약 50% 영역에서 추출한 캐릭터만 표시되어야 한다.",
    "캐릭터가 가장 크게 보이도록 crop 기준을 잡고, 배경은 보조 요소로만 남긴다.",
    "titleArea와 writingBoxArea는 전시 화면에 절대 보이지 않는다.",
    "이미 업로드된 학습지의 cutoutUrl이 캐싱되어 있으면, crop 기준 변경 후 전체 삭제 후 재업로드해야 새 기준이 적용된다.",
    "보조 안전장치는 crop 영역 조정으로 우선 처리한다. 픽셀 단위 후처리는 캐릭터를 자를 위험이 있어 사용하지 않는다."
  ]
}