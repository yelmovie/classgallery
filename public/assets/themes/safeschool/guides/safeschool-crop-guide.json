{
  "themeId": "safeschool",
  "version": "1.0.0",
  "worksheetRatio": "A4_VERTICAL",
  "purpose": "Teacher uploads the full worksheet image. The app crops only the top character illustration area, then removes the outer paper background so the colored character appears on the exhibition screen.",
  "characterCropArea": {
    "x": 0.06,
    "y": 0.03,
    "width": 0.88,
    "height": 0.47
  },
  "titleArea": {
    "x": 0.07,
    "y": 0.53,
    "width": 0.86,
    "height": 0.06
  },
  "promptArea": {
    "x": 0.07,
    "y": 0.59,
    "width": 0.86,
    "height": 0.05
  },
  "writingBoxArea": {
    "x": 0.07,
    "y": 0.66,
    "width": 0.86,
    "height": 0.27
  },
  "extractionRules": {
    "preserveCharacterColor": true,
    "preserveOriginalRgb": true,
    "makeCharacterOpaque": true,
    "removeOnlyOuterPaperBackground": true,
    "doNotRemoveInnerWhiteAreas": true,
    "doNotReduceOpacity": true,
    "addWhiteOuterBorder": true,
    "addSoftShadow": true
  },
  "displayRules": {
    "displayMode": "character_cutout_only",
    "doNotDisplayFullWorksheetCard": true,
    "doNotDisplayTitleArea": true,
    "doNotDisplayPromptArea": true,
    "doNotDisplayWritingBoxArea": true,
    "maxArtworks": 30,
    "recommendedArtworks": 24,
    "defaultSpeed": "slow",
    "spotlightEnabled": true
  },
  "notes": [
    "Only the top character illustration area should be used for exhibition.",
    "The title, prompt text, and writing box must never appear on the exhibition screen.",
    "The character itself must remain fully opaque and visually clear.",
    "Only the outer paper background should be removed."
  ]
}